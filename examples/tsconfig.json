{
  "$schema": "../node_modules/@effect/tsgo/schema.json",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "customConditions": ["bun"],
    "jsx": "react-jsx"
  },
  "include": ["."],
  // Typechecked against React Native's types by `bun run test:react-native` (`tools/react-native/check.ts`), which
  // installs them in a project of its own.
  "exclude": ["react-native"]
}
