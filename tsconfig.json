{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect"],
        "importAliases": {
          "Array": "Arr",
          "Option": "Opt"
        },
        "overrides": [
          // The language service's default, which a list of overrides replaces.
          { "include": ["src/**/*.ts"], "options": { "diagnosticSeverity": { "floatingEffect": "error" } } },
          // The tools are not packed, and no user copies them: they may build on what Effect marks unstable, as
          // `AGENTS.md` says ("Only stable APIs"). Not the files that stand for a user's code.
          {
            "include": ["tools/**/*.ts"],
            "exclude": ["tools/smoke/consumer.ts", "tools/inference/prelude.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/cli",
                "effect/FileSystem",
                "effect/Path",
                "effect/process",
                "@effect/platform-bun"
              ]
            }
          }
        ]
      }
    ],
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src", "test", "tools"],
  // The consumers of the packed package, typechecked by the smoke test against its declarations.
  "exclude": ["tools/smoke/consumer.ts", "tools/smoke/bridges.ts", "tools/smoke/misprint.ts"]
}
