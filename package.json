{
  "name": "@fgaudo/effect-tea",
  "version": "0.1.0",
  "description": "The Elm architecture on Effect: a pure update, effects as commands and subscriptions, and offers that keep the view and update in agreement.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepack": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
