{
  "name": "@fgaudo/effect-tea",
  "version": "0.8.0",
  "description": "The Elm architecture on Effect v4",
  "license": "MIT",
  "author": "Francesco Gaudenzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgaudo/effect-tea.git"
  },
  "homepage": "https://fgaudo.github.io/effect-tea/",
  "bugs": "https://github.com/fgaudo/effect-tea/issues",
  "keywords": ["effect", "elm", "tea", "elm-architecture", "state-management"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./snabbdom": {
      "bun": "./bridges/snabbdom.ts",
      "types": "./dist/bridges/snabbdom.d.ts",
      "default": "./dist/bridges/snabbdom.js"
    },
    "./snabbdom/testing": {
      "bun": "./bridges/snabbdom-testing.ts",
      "types": "./dist/bridges/snabbdom-testing.d.ts",
      "default": "./dist/bridges/snabbdom-testing.js"
    },
    "./react": {
      "bun": "./bridges/react.ts",
      "types": "./dist/bridges/react.d.ts",
      "default": "./dist/bridges/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test_*.ts",
    "site/guide",
    "site/tutorial",
    "examples",
    "!examples/tsconfig.json",
    "bridges",
    "!bridges/tsconfig.json",
    "!bridges/tsconfig.build.json",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun tools/build.ts",
    "prepack": "bun tools/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples && tsc --noEmit -p bridges",
    "lint": "oxlint --deny-warnings && dprint check",
    "format": "oxlint --fix && dprint fmt",
    "test": "bun test --path-ignore-patterns=src/interleaving.test.ts",
    "test:node": "node --expose-gc --max-old-space-size=2048 --import ./test/node/register.test_hook.ts --test \"src/**/!(interleaving).test.ts\" \"test/*.test.ts\"",
    "interleavings": "bun test src/interleaving.test.ts",
    "bench": "bun tools/bench/subscriptions.ts",
    "mutations": "bun tools/mutations/mutate.ts",
    "smoke": "bun tools/smoke/smoke.ts",
    "inference": "bun tools/inference/generate.ts",
    "api": "bun tools/api-report.ts",
    "comments": "bun tools/comments.ts",
    "prepare": "bunx effect-tsgo patch --typescript --no-oxlint"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "peerDependencies": {
    "effect": "~4.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snabbdom": "^3.6.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "snabbdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "~4.1.4",
    "@effect/tsgo": "0.70.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dprint": "^0.65.0",
    "effect": "~4.1.4",
    "expect": "^30.5.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snabbdom": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
