{
  "name": "@fgaudo/effect-tea",
  "version": "0.7.2",
  "description": "The Elm architecture on Effect v4",
  "license": "MIT",
  "author": "Francesco Gaudenzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgaudo/effect-tea.git"
  },
  "homepage": "https://fgaudo.github.io/effect-tea/",
  "bugs": "https://github.com/fgaudo/effect-tea/issues",
  "keywords": ["effect", "elm", "tea", "elm-architecture", "state-management"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepack": "bun build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "biome lint . && oxlint --type-aware",
    "test": "bun test",
    "prepare": "bunx effect-tsgo patch --typescript --no-oxlint"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/platform-browser": "^4.0.5",
    "@effect/tsgo": "0.53.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "^4.0.5",
    "fast-check": "^4.10.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snabbdom": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
