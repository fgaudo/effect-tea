{
  "name": "@fgaudo/effect-tea",
  "version": "0.2.0",
  "description": "The Elm architecture on Effect v4",
  "license": "MIT",
  "author": "Francesco Gaudenzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgaudo/effect-tea.git"
  },
  "homepage": "https://github.com/fgaudo/effect-tea#readme",
  "bugs": "https://github.com/fgaudo/effect-tea/issues",
  "keywords": ["effect", "elm", "tea", "elm-architecture", "state-management"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./next": {
      "bun": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepack": "bun build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "biome lint .",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/platform-browser": "^4.0.5",
    "@types/bun": "^1.4.3",
    "effect": "^4.0.5",
    "fast-check": "^4.10.2",
    "snabbdom": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
